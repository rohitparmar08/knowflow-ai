# ==============================================================================
# Django Core Settings
# ==============================================================================
SECRET_KEY=django-insecure-change-this-in-production-knowflow-ai-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional production SSL / HSTS headers
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# ==============================================================================
# Database Configuration (PostgreSQL with pgvector)
# ==============================================================================
# Option 1: Standard DB connection parameters
DB_NAME=knowflow_ai
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Option 2: Full DATABASE_URL connection string (takes precedence if set)
# DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/knowflow_ai

# ==============================================================================
# LLM & RAG Configuration
# ==============================================================================
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.8
