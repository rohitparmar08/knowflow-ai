# ==============================================================================
# Django Core Settings
# ==============================================================================
# Required when DEBUG is off (the app refuses to start without it).
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# DEBUG defaults to False. Set True only for local development.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional production SSL / HSTS headers
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
# Set True when behind a TLS-terminating proxy (Render, Railway, Fly.io, HF Spaces, nginx)
TRUST_PROXY_SSL_HEADER=False

# Rate limits (DRF format)
THROTTLE_ASK=20/min
THROTTLE_AUTH=10/min

# Where uploaded files are stored (point at a persistent disk in production)
# MEDIA_ROOT=/var/data/media

# ==============================================================================
# Database Configuration (PostgreSQL with pgvector)
# ==============================================================================
# Option 1: Standard DB connection parameters
DB_NAME=knowflow_ai
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Option 2: Full DATABASE_URL connection string (takes precedence if set)
# DATABASE_URL=postgres://postgres:your_postgres_password@localhost:5432/knowflow_ai

# ==============================================================================
# LLM & RAG Configuration
# ==============================================================================
LLM_API_KEY=your-key-here
LLM_MODEL=gemini-2.5-flash
# Optional: a second model to try when the primary one is overloaded or rate limited
LLM_FALLBACK_MODEL=
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=8
RAG_MAX_DISTANCE=0.8
